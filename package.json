{
  "name": "eleventy-base-blog",
  "version": "9.0.0",
  "description": "A starter repository for a blog web site using the Eleventy site generator.",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "build-nocolor": "cross-env NODE_DISABLE_COLORS=1 eleventy",
    "build-ghpages": "eleventy --pathprefix=/eleventy-base-blog/",
    "start": "eleventy --serve --quiet",
    "start-ghpages": "eleventy --pathprefix=/eleventy-base-blog/ --serve --quiet",
    "debug": "cross-env DEBUG=Eleventy* eleventy",
    "debugstart": "cross-env DEBUG=Eleventy* eleventy --serve --quiet",
    "benchmark": "cross-env DEBUG=Eleventy:Benchmark* eleventy",
    "bench": "cross-env DEBUG=Eleventy:Benchmark* eleventy",
    "watch": "eleventy --watch",
    "serve": "eleventy --serve",
    "dev": "eleventy --serve",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/eleventy-base-blog.git"
  },
  "author": "Zach Leatherman (https://zachleat.com/)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/11ty"
  },
  "bugs": {
    "url": "https://github.com/11ty/eleventy-base-blog/issues"
  },
  "homepage": "https://github.com/11ty/eleventy-base-blog#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "luxon": "^3.7.2",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "prismjs": "^1.30.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@zachleat/heading-anchors": "^1.0.5"
  }
}
